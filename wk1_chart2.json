{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Real GDP Per Capita"
  },

  "width": 500,
  "height": 300,

  "data": {"url": "https://raw.githubusercontent.com/EconomicsObservatory/courses/main/1/s1_example_data/chart2_GDP_pc_6_countries.csv"},

  "mark": "line",

  "encoding": {
    "x": {
      "field": "Year",
      "type": "temporal",
      "title": "Source: World Bank",
      "axis": {
        "titleAnchor": "start",
        "titleFontSize": 11,
        "titleFontWeight": "normal",
        "titleColor": "#555555",
        "titlePadding": 15
      }
    },
    "y": {
      "field": "GDP pc",
      "type": "quantitative",
      "title": "GDP per capita (current international USD, PPP)",
      "axis": {"titlePadding": 20}
    },
    "color": {"field": "Country Name", "type": "nominal"}
  }
}