{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Power plants in Wales",
    "subtitle": "One circle per plant: size shows capacity (MW), colour shows fuel",
    "anchor": "middle",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "width": 480,
  "height": 560,
  "config": {
    "view": {"stroke": null},
    "font": "DM Sans"
  },
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/krshmashah13/krshmashah13.github.io/refs/heads/main/wales_councils.json",
        "format": {"type": "topojson", "feature": "geog"}
      },
      "mark": {"type": "geoshape", "fill": "#e8e8e8", "stroke": "#ffffff", "strokeWidth": 0.8}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/krshmashah13/krshmashah13.github.io/refs/heads/main/wales_power_plants.csv",
        "format": {"type": "csv", "parse": {"latitude": "number", "longitude": "number", "capacity_mw": "number"}}
      },
      "mark": {"type": "circle", "opacity": 0.75, "stroke": "#ffffff", "strokeWidth": 0.5},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "order": {"field": "capacity_mw", "type": "quantitative", "sort": "descending"},
        "color": {
          "field": "fuel_category",
          "type": "nominal",
          "title": "Fuel",
          "scale": {
            "domain": ["Gas", "Hydro", "Coal", "Wind", "Solar", "Biomass"],
            "range": ["#CC79A7", "#1d4ed8", "#333333", "#009E73", "#E69F00", "#7B3294"]
          }
        },
        "size": {
          "field": "capacity_mw",
          "type": "quantitative",
          "title": "Capacity (MW)",
          "scale": {"type": "sqrt", "range": [8, 700]},
          "legend": {"values": [10, 100, 500, 2000], "format": ",.0f"}
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Power plant"},
          {"field": "fuel_category", "type": "nominal", "title": "Fuel"},
          {"field": "capacity_mw", "type": "quantitative", "format": ",.1f", "title": "Capacity (MW)"}
        ]
      }
    }
  ]
}
