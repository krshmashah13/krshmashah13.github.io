{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "India's Nuclear Power Output"
  },
  "height": 300,
  "width": 500,
  "background": "#ffffff",
  "view": {
    "fill": "#ffffff",
    "strokeOpacity": 0
  },
  "data": {
    "url": "https://raw.githubusercontent.com/krshmashah13/krshmashah13.github.io/refs/heads/main/india_nuclear.csv",
    "format": {
      "type": "csv"
    }
  },
  "mark": {
    "type": "line",
    "color": "#1d4ed8",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {
        "title": "Source: IEA via ECO-API",
        "titleAnchor": "start",
        "titleFontSize": 11,
        "titleFontWeight": "normal",
        "titleColor": "#555555",
        "titlePadding": 15
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "title": "Nuclear power output (GWh)",
        "titlePadding": 20
      }
    }
  }
}